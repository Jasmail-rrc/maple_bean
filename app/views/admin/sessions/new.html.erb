
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5">

      <div class="card shadow-sm">
        <div class="card-body p-4">

          <h2 class="text-center fw-bold mb-3">
            Admin Login
          </h2>

          <p class="text-center text-muted mb-4">
            Maple Bean Coffee Shop
          </p>

          <%= form_with url: admin_login_path, method: :post, local: true do %>

            <div class="mb-3">
              <%= label_tag :username, "Username", class: "form-label" %>
              <%= text_field_tag :username, nil,
                  class: "form-control",
                  required: true,
                  autocomplete: "username" %>
            </div>

            <div class="mb-3">
              <%= label_tag :password, "Password", class: "form-label" %>
              <%= password_field_tag :password, nil,
                  class: "form-control",
                  required: true,
                  autocomplete: "current-password" %>
            </div>

            <%= submit_tag "Login", class: "btn btn-dark w-100" %>

          <% end %>

          <div class="text-center mt-3">
            <%= link_to "Back to Home", root_path %>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>

