
<div class="container py-5">
  <h1 class="text-center fw-bold mb-4">
    Your Shopping Cart 🛒
  </h1>

  <% if @cart_items.any? %>
    <div class="table-responsive">
      <table class="table table-bordered align-middle">
        <thead class="table-dark">
          <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Total</th>
            <th>Action</th>
          </tr>
        </thead>

        <tbody>
          <% @cart_items.each do |item| %>
            <tr>
              <td>
                <%= link_to item[:product].name,
                    product_path(item[:product]) %>
              </td>

              <td>
                <%= number_to_currency(
                    item[:product].price, unit: "CA$") %>
              </td>

              <td>
                <%= form_with url: update_cart_path,
                    method: :patch, local: true do %>

                  <%= hidden_field_tag :product_id,
                      item[:product].id %>

                  <div class="d-flex gap-2">
                    <%= number_field_tag :quantity,
                        item[:quantity],
                        min: 1,
                        max: item[:product].stock_quantity,
                        class: "form-control",
                        style: "width: 85px;" %>

                    <%= submit_tag "Update",
                        class: "btn btn-primary btn-sm" %>
                  </div>
                <% end %>
              </td>

              <td>
                <%= number_to_currency(
                    item[:total], unit: "CA$") %>
              </td>

              <td>
                <%= button_to "Remove",
                    remove_from_cart_path(
                      product_id: item[:product].id
                    ),
                    method: :delete,
                    class: "btn btn-danger btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="text-end mt-4">
      <h3>
        Subtotal:
        <%= number_to_currency(
            @cart_total, unit: "CA$") %>
      </h3>

      <p class="text-muted">
        Taxes and shipping will be calculated at checkout.
      </p>

      <%= link_to "Continue Shopping",
          products_path,
          class: "btn btn-outline-dark mt-2" %>
    </div>

  <% else %>
    <div class="alert alert-info text-center">
      Your shopping cart is empty.
    </div>

    <div class="text-center">
      <%= link_to "Browse Products",
          products_path,
          class: "btn btn-dark" %>
    </div>
  <% end %>
</div>
