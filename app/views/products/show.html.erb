
<div class="container py-5">

<!-- Breadcrumb Navigation -->
<nav aria-label="breadcrumb">
  <ol class="breadcrumb">

    <li class="breadcrumb-item">
      <%= link_to "Home", root_path %>
    </li>

    <li class="breadcrumb-item">
      <%= link_to "Products", products_path %>
    </li>

    <li class="breadcrumb-item active" aria-current="page">
      <%= @product.name %>
    </li>

  </ol>
</nav>

  <div class="row justify-content-center">
    <div class="col-md-8">

      <div class="card shadow-sm">
        <div class="card-body p-4">

          <h1 class="fw-bold mb-4">
            <%= @product.name %>
          </h1>

          <h5>Product Description</h5>

          <p class="text-muted">
            <%= @product.description %>
          </p>

          <h3 class="text-success mt-4">
            <%= number_to_currency(@product.price, unit: "CA$") %>
          </h3>

          <p class="mt-3">
            <strong>Availability:</strong>

            <% if @product.stock_quantity > 0 %>
              <span class="text-success">
                In Stock (<%= @product.stock_quantity %> available)
              </span>
            <% else %>
              <span class="text-danger">
                Out of Stock
              </span>
            <% end %>
          </p>

          <hr>

          
<hr>

<% if @product.stock_quantity > 0 %>
  <%= form_with url: add_to_cart_path, method: :post, local: true do %>
    <%= hidden_field_tag :product_id, @product.id %>

    <div class="mb-3">
      <%= label_tag :quantity, "Quantity", class: "form-label" %>

      <%= number_field_tag :quantity, 1,
          min: 1,
          max: @product.stock_quantity,
          class: "form-control",
          style: "width: 120px;" %>
    </div>

    <%= submit_tag "Add to Cart",
        class: "btn btn-success mb-3" %>
  <% end %>
<% else %>
  <p class="text-danger">This product is currently unavailable.</p>
<% end %>

<div>
  <%= link_to "Back to Products",
      products_path,
      class: "btn btn-dark" %>

  <%= link_to "View Cart",
      cart_path,
      class: "btn btn-outline-dark" %>
</div>


        </div>
      </div>

    </div>
  </div>
</div>

