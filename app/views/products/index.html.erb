<div class="container py-5">

  <!-- Breadcrumb Navigation -->
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item">
        <%= link_to "Home", root_path %>
      </li>

      <li class="breadcrumb-item active" aria-current="page">
        Products
      </li>
    </ol>
  </nav>

  <h1 class="text-center fw-bold mb-3">
    Our Coffee Shop Products ☕
  </h1>

  <p class="text-center text-muted mb-4">
    Explore our coffee beans, ground coffee,
    mugs, and brewing accessories.
  </p>

  <!-- Search Form -->
  <div class="card shadow-sm mb-5">
    <div class="card-body">
      <%= form_with url: products_path, method: :get, local: true do %>
        <div class="row g-3 align-items-end">

          <div class="col-md-4">
            <%= label_tag :search, "Search Products", class: "form-label" %>

            <%= text_field_tag :search, params[:search],
                class: "form-control",
                placeholder: "Search coffee, mugs, accessories..." %>
          </div>

          <div class="col-md-3">
            <%= label_tag :category_id, "Category", class: "form-label" %>

            <%= select_tag :category_id,
                options_from_collection_for_select(
                  @categories, :id, :name, params[:category_id]
                ),
                include_blank: "All Categories",
                class: "form-select" %>
          </div>

          <div class="col-md-3">
            <%= label_tag :filter, "Filter Products", class: "form-label" %>

            <%= select_tag :filter,
                options_for_select([
                  ["All Products", ""],
                  ["New Products", "new"],
                  ["Recently Updated", "recently_updated"]
                ], params[:filter]),
                class: "form-select" %>
          </div>

          <div class="col-md-2">
            <%= submit_tag "Search",
                class: "btn btn-dark w-100" %>
          </div>

        </div>
      <% end %>
    </div>
  </div>

  <!-- Product Listings Using Rails Partial -->
  <div class="row g-4">
    <% @products.each do |product| %>
      <%= render "product_card", product: product %>
    <% end %>
  </div>

  <!-- No Products Found Message -->
  <% if @products.empty? %>
    <div class="alert alert-warning text-center mt-4">
      No products found. Try another search.
    </div>
  <% end %>

  <!-- Pagination -->
  <div class="d-flex justify-content-center mt-4">
    <%= paginate @products %>
  </div>

  <!-- Show All Products Button -->
  <div class="text-center mt-5">
    <%= link_to "Show All Products",
        products_path,
        class: "btn btn-outline-dark" %>
  </div>

</div>